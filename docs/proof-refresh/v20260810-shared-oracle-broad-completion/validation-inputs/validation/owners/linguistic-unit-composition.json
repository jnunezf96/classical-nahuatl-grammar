  "atomRelations": [
    {
      "relationId": "atom-relation:linguistic-unit-composition:structure-adds-constraint",
      "fromAtomId": "ACI-P027-L006-3F63976A21",
      "toAtomId": "ACI-P027-L005-FCA7823D2B",
      "relationType": "adds-constraint",
      "basis": "The linear-sequence rule admits the medium-specific sequence, while the following atom additionally requires its parts to be patterned into a linguistically valid whole.",
      "discriminatingCaseIds": [
        "case:linguistic-unit-composition:reject-unstructured-speech"
      ]
    },
    {
      "relationId": "atom-relation:linguistic-unit-composition:binary-unity-refines-composition",
      "fromAtomId": "ACI-P027-L007-F8C79B445B",
      "toAtomId": "ACI-P027-L005-FCA7823D2B",
      "relationType": "refines",
      "basis": "The 1 + 1 = 1 principle refines general sequence combination as a binary operation whose direct result is one unit; larger sequences require separately proved recursive application.",
      "discriminatingCaseIds": [
        "case:linguistic-unit-composition:reject-three-constituents"
      ]
    },
    {
      "relationId": "atom-relation:linguistic-unit-composition:unit-input-output-refines-binary-unity",
      "fromAtomId": "ACI-P027-L008-6551E0E9EF",
      "toAtomId": "ACI-P027-L007-F8C79B445B",
      "relationType": "refines",
      "basis": "The constituent rule specifies that both binary inputs must already be units and that the binary result is itself a complex unit, beyond the documentary arithmetic shorthand.",
      "discriminatingCaseIds": [
        "case:linguistic-unit-composition:reject-documentary-structure"
      ]
    }
  ],
  "contractBoundary": {
    "inputAuthority": "owner-issued-complete-typed-linguistic-unit-composition-source-with-two-owner-issued-basic-linear-element-results",
    "suppliedFacts": [
      "medium",
      "sequenceOrder",
      "structurePattern",
      "constituents"
    ],
    "validatedHere": [
      "speech linear sequences are temporal and written linear sequences are spatial",
      "a linguistically valid sequence has parts patterned into a whole",
      "exactly two admitted constituent units compose directly into one result unit",
      "the composition result is one typed complex structural unit",
      "non-unit, documentary, formula, lesson, stored-answer, and surface carriers cannot authorize composition"
    ],
    "validatedElsewhere": [
      "the internal grammar of each constituent unit",
      "discontinuous-unit admissibility and cohesion",
      "recursive reapplication of composition",
      "meaningful and meaningless structural-unit hierarchies",
      "sounded and written surface realization"
    ]
  },
