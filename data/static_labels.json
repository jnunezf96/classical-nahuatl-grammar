  "tenseDescriptions": {
    "presente": {
      "labelEs": "acciones actuales o en progreso"
    },
    "optativo": {
      "labelEs": "modo optativo: deseo, mandato, exhortación o petición"
    },
    "presente-habitual": {
      "labelEs": "acción repetida o costumbre"
    },
    "presente-desiderativo": {
      "labelEs": "deseo, intención o propósito"
    },
    "imperfecto": {
      "labelEs": "pasado en desarrollo o continuo"
    },
    "preterito": {
      "labelEs": "pasado puntual con cierre perfectivo"
    },
    "pasado-remoto": {
      "labelEs": "pasado distante con cierre perfectivo"
    },
    "perfecto": {
      "labelEs": "pasado con resultado vigente"
    },
    "pluscuamperfecto": {
      "labelEs": "pasado anterior a otro pasado"
    },
    "condicional-perfecto": {
      "labelEs": "pasado hipotético o no realizado"
    },
    "futuro": {
      "labelEs": "evento proyectado o esperado"
    },
    "condicional": {
      "labelEs": "posibilidad, duda o cortesía"
    },
    "sustantivo-verbal": {
      "labelEs": "acción tratada como sustantivo (sustantivo derivado del verbo con -lis)"
    },
    "potencial": {
      "labelEs": "adjetivo activo como conjugación verbal en futuro imperfectivo"
    },
    "potencial-habitual": {
      "labelEs": "adjetivo no activo como conjugación verbal en presente habitual"
    },
    "adjetivo-preterito": {
      "labelEs": "adjetivo como conjugación verbal en pretérito perfecto simple"
    },
    "adjetivo-perfecto": {
      "labelEs": "adjetivo como conjugación verbal en pretérito perfecto compuesto"
    },
    "adjetivo-preterito-tik": {
      "labelEs": "adjetivo activo en pretérito con sufijo -tik"
    },
    "adjetivo-perfecto-tik": {
      "labelEs": "adjetivo activo en perfecto con sufijo -tik"
    },
    "adjetivo-preterito-naj": {
      "labelEs": "adjetivo activo en pretérito con sufijo -naj; usa base de tronco verbal, salvo finales en -ya/-tiya que usan la base de pretérito (excepto -wiya)"
    },
    "adjetivo-perfecto-naj": {
      "labelEs": "adjetivo activo en perfecto con sufijo -naj; usa base de tronco verbal, salvo finales en -ya/-tiya que usan la base de pretérito (excepto -wiya)"
    },
    "adjetivo-patientivo-no-activo": {
      "labelEs": "adjetivo derivado del patientivo no activo con sufijo -ti"
    },
    "adjetivo-patientivo-perfectivo": {
      "labelEs": "adjetivo derivado del patientivo perfectivo con sufijo -ti"
    },
    "pasado-remoto-adverbio-activo": {
      "labelEs": "adverbio de manera en que alguien hace algo derivado del pretérito agentivo"
    },
    "agentivo": {
      "labelEs": "persona o entidad que realiza la acción (sustantivo derivado del presente habitual -ni)"
    },
    "agentivo-presente": {
      "labelEs": "persona o entidad caracterizada por el predicado presente; absolutivo solamente"
    },
    "agentivo-preterito": {
      "labelEs": "persona o entidad caracterizada por el predicado pretérito; restringido absolutivo y general posesivo con -ka"
    },
    "agentivo-futuro": {
      "labelEs": "persona o entidad caracterizada por el predicado futuro; restringido absolutivo y general posesivo con -ka"
    },
    "patientivo": {
      "labelEs": "persona o entidad que existe cuando ocurre un evento (sustantivo derivado de base no activa/perfectiva/imperfectiva/tronco verbal)"
    },
    "instrumentivo": {
      "labelEs": "medio o herramienta de la acción (sustantivo derivado de base no activa + presente habitual -ni, o de base activa + imperfecto -ya)"
    },
    "predicado-nominal": {
      "labelEs": "NNC derivada desde un predicado CNV; conserva la marca de tiempo fuente dentro del tronco nominal"
    },
    "calificativo-instrumentivo": {
      "labelEs": "cualidad derivada del pasado (sustantivo derivado del pasado remoto -ka + -yut/posesivo)"
    },
    "locativo-temporal": {
      "labelEs": "lugar o tiempo donde ocurre la acción (sustantivo derivado del imperfecto -ya + -n en base activa/no activa)"
    }
  },
  "preteritoClassDetailByKey": {
    "A": {
      "label": {
        "labelEs": "Clase A: -ki / -Ø"
      },
      "description": {
        "labelEs": "pérdida de vocal final en perfectivo"
      }
    },
    "B": {
      "label": {
        "labelEs": "Clase B: +k"
      },
      "description": {
        "labelEs": "conserva vocal y añade -k"
      }
    },
    "C": {
      "label": {
        "labelEs": "Clase C: -j"
      },
      "description": {
        "labelEs": "alterna la raíz a -j"
      }
    },
    "D": {
      "label": {
        "labelEs": "Clase D: +j"
      },
      "description": {
        "labelEs": "añade -j al perfectivo"
      }
    }
  }
}
